# === Aplicação ===
APP_NAME=CaisMed API
APP_VERSION=1.0.0
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api
APP_TIMEZONE=America/Recife

# === Banco de Dados ===
# Desenvolvimento local (SQLite):
DATABASE_URL=sqlite:///./caismed.db
# Produção (PostgreSQL — exemplo Render/Railway/Supabase):
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/caismed

# === Segurança / JWT ===
# Em produção, gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=caismed-dev-secret-key-troque-em-producao-com-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# === CORS ===
# Lista separada por vírgulas (ou * para liberar qualquer origem em testes)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://127.0.0.1:8081

# === Inteligência Artificial (Google Gemini) ===
# Se vazia ou em caso de timeout/erro, a pré-triagem usa fallback seguro automaticamente
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=8.0
